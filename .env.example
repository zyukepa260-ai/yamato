# ============================================================
#  毎朝8時ニュースダイジェスト  環境変数サンプル
#  使い方: cp .env.example .env して値を埋める
# ============================================================

# ---------- 要約エンジン（Claude） ----------
# 未設定でも動作します（その場合はLLMを使わない簡易要約にフォールバック）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 配信先の選択（カンマ区切り / email,slack,discord,file） ----------
DIGEST_NOTIFIERS=email

# ---------- メール配信（Gmail の例） ----------
# Gmail の場合は「アプリパスワード」を使用してください（通常のログインPWは不可）
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=your-address@gmail.com
MAIL_TO=your-address@gmail.com          # カンマ区切りで複数指定可

# ---------- Slack 配信（任意） ----------
SLACK_WEBHOOK_URL=

# ---------- Discord 配信（任意） ----------
DISCORD_WEBHOOK_URL=

# ---------- 動作設定 ----------
DIGEST_TIMEZONE=Asia/Tokyo
DIGEST_LOOKBACK_HOURS=24      # 何時間前までの記事を対象にするか
DIGEST_MAX_ARTICLES=140       # LLMに渡す記事の上限（コスト制御）
DIGEST_LEGAL_MIN=8            # 法学セクションに最低限載せたい本数
